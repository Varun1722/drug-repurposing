# Copy this file to .env and fill in your own keys.
# .env is already gitignored — never commit real keys.

# --- LLM (writing, extraction, reasoning) ---
OPENAI_API_KEY=
# Optional — defaults to gpt-5.6-terra if unset.
OPENAI_MODEL=

# --- Live web search (used where the pipeline needs real grounding,
# e.g. discovering repurposing candidates, or the protein-extraction
# fallback) ---
EXA_API_KEY=

# --- Molecular docking (Modal serverless CPU running GNINA) ---
# Both printed by `modal deploy modal_app/gnina_worker.py` — see
# modal_app/README.md. GNINA_ENDPOINT_URL is the old synchronous endpoint
# (agent3.py only); the Next.js app uses the async job queue.
GNINA_ENDPOINT_URL=
# https://<workspace>--gnina-worker-job-api.modal.run
# Unauthenticated by design (see modal_app/README.md) — anyone with this
# URL can submit/poll jobs, bounded only by the caps in gnina_worker.py.
GNINA_JOB_API_URL=

# --- PubMed literature search (E-utilities) — both optional ---
# No API key is required for basic use (3 requests/sec). Set these only if
# you want the higher 10 req/sec rate limit and to follow NCBI's courtesy
# identification policy.
NCBI_API_KEY=
NCBI_CONTACT_EMAIL=

# --- router_agent.py only (Fetch.ai/Agentverse chat agent) ---
# All optional; only relevant if you're running router_agent.py.
# TS_API_BASE=http://localhost:3000
# MAX_CHAT_CHARS=3500
# SEND_RETRIES=3
# SEND_RETRY_DELAY_SECONDS=1.0
# SEND_PACING_SECONDS=0.5
