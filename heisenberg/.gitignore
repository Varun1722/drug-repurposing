# Next.js app. Shared ignores (node_modules, .next, .env, caches) are in the
# repo-root .gitignore; the app-specific ones are repeated here so the folder
# is safe to use on its own.

.env
.env.*
!.env.example
/.next/
/out/
/coverage/
.vercel
*.tsbuildinfo
npm-debug.log*
.pnpm-debug.log*

# v0 runtime files (only exist in preview, never in git)
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts

# Local leftovers that are not part of the app (safe to delete, see docs/roadmap.md)
/deprecated/
/styles/
